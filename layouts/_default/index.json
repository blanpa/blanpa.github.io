{{- /* Search index (Fuse.js, fetched by the theme's search.js the first time
       the search overlay is opened).

       Two changes against Blowfish's version:

       1. Taxonomy and term pages are left out. They made up half the index
          (29 of 61 entries) and turned every topical query into a duplicate:
          "modbus" matched the article *and* /tags/modbus/, which is a list of
          the same article.
       2. Whitespace in the indexed body is collapsed — .Plain keeps the
          markdown's line breaks, which cost two bytes each once escaped into
          JSON. Worth a few KB, nothing more; the point is that a substring
          matcher has no use for them.

       The full article text is kept on purpose: search.js fetches this file
       only when the search overlay is first opened, so trimming the bodies
       would buy nothing on page load and would cost hits in the second half
       of long posts. */ -}}
{{- $index := slice -}}
{{- $pages := where .Site.Pages "Kind" "in" (slice "home" "page" "section") -}}
{{- range .Site.Home.Translations -}}
  {{- $pages = $pages | lang.Merge (where .Site.Pages "Kind" "in" (slice "home" "page" "section")) -}}
{{- end -}}
{{- range $pages -}}
  {{- if not .Params.excludeFromSearch -}}
    {{- $section := .Site.GetPage "section" .Section -}}
    {{- $entry := dict
      "title" (.Title | emojify | safeJS)
      "section" (cond (ne $section nil) ($section.Title | emojify | safeJS) "")
      "summary" (.Summary | plainify | htmlUnescape | safeJS)
      "content" (.Plain | replaceRE `\s+` " " | strings.TrimSpace | safeJS)
      "permalink" .RelPermalink
      "externalUrl" .Params.externalUrl
      "type" .Type
    -}}
    {{- if .Date -}}
      {{- $entry = merge $entry (dict "date" (.Date | time.Format (.Site.Language.Params.dateFormat | default ":date_long"))) -}}
    {{- end -}}
    {{- $index = $index | append $entry -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
